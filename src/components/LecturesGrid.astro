---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { formatCourseDate } from "../lib/dates";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<CardGrid columns={2}>
  {
    visible.map((lecture) => (
      <Card headingLevel="h2" title={lecture.data.title} href={`/lectures/${lecture.id}/`}>
        <span class="week-badge">Week {String(lecture.data.week).padStart(2, "0")}</span>
        {lecture.data.description && <p>{lecture.data.description}</p>}
        <p><small>{formatCourseDate(lecture.data.date)}</small></p>
      </Card>
    ))
  }
</CardGrid>

<style>
  .week-badge {
    display: inline-block;
    margin-block-end: 0.6rem;
    padding: 0.15rem 0.55rem;
    border-radius: 0.2rem;
    background: var(--at-accent);
    color: var(--at-on-primary);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.04em;
  }
</style>
