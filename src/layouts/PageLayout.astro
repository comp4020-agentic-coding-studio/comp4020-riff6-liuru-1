---
import MdxPageLayout from "astro-theme-university/layouts/MdxPageLayout.astro";
import { siteConfig } from "../site-config";
---

<MdxPageLayout siteConfig={siteConfig} {...Astro.props}>
  <slot />
</MdxPageLayout>

<style is:global>
  /* Slop-university-brand tokens stay the source of truth for spacing and
     type scale; this block only retunes colour and a couple of rhythm
     values toward paper-and-ink-and-seals, unlayered so it wins over the
     theme's @layer at.tokens regardless of import order. */
  :root {
    --at-primary: #9a3324;
    --at-bg: #faf3e2;
    --at-bg-alt: #f1e6cd;
    --at-bg-elevated: #fdf8ec;
    --at-text: #1c1a17;
    --at-text-secondary: rgb(28 26 23 / 78%);
    --at-text-muted: rgb(28 26 23 / 60%);
    --at-heading: #1c1a17;
    --at-link: #9a3324;
    --at-link-hover: #7a2819;
    --at-accent: #9a3324;
    --at-border: rgb(28 26 23 / 20%);
    --at-divider: rgb(28 26 23 / 14%);
    --at-spacing-2xl: 5rem;
  }

  [data-theme="dark"] {
    --at-bg: #201a14;
    --at-bg-alt: #2a2119;
    --at-bg-elevated: #251e17;
    --at-text: #f1e6cd;
    --at-text-secondary: rgb(241 230 205 / 78%);
    --at-text-muted: rgb(241 230 205 / 60%);
    --at-heading: #f1e6cd;
    --at-link: #dd8f7c;
    --at-link-hover: #ecb1a2;
    --at-accent: #dd8f7c;
    --at-border: rgb(241 230 205 / 20%);
    --at-divider: rgb(241 230 205 / 14%);
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: Georgia, "Noto Serif", "Songti SC", serif;
  }

  h2 {
    margin-block-start: 2.5em;
    padding-block-end: 0.35em;
    border-block-end: 1px solid var(--at-divider);
  }
</style>
