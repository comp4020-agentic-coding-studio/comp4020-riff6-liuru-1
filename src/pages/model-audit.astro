---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { siteConfig } from "../site-config";
---

<ContentLayout
  title="Break the stroke classifier"
  description="Draw a single stroke. The toy classifier will decide whether it
    looks more like Tang Yin or a workshop copy. Then change your stroke and
    see if you can expose what the model is really relying on."
  {...siteConfig}
>
  <ol class="steps">
    <li>
      <span class="step-num">01</span>
      <span class="step-title">Draw</span>
      <p>Draw one continuous stroke.</p>
    </li>
    <li>
      <span class="step-num">02</span>
      <span class="step-title">Classify</span>
      <p>Let the model inspect its simple stroke features.</p>
    </li>
    <li>
      <span class="step-num">03</span>
      <span class="step-title">Break it</span>
      <p>Change the length, curvature, or shape and see whether the prediction changes.</p>
    </li>
  </ol>

  <div class="audit-board" id="audit-board">
    <div class="audit-draw">
      <canvas
        id="stroke-canvas"
        width="520"
        height="260"
        aria-label="Drawing canvas: draw one stroke with your mouse or finger"
      ></canvas>
      <p class="hint">Draw one continuous stroke.</p>
      <button type="button" id="clear-btn">Clear</button>
    </div>

    <div class="audit-result">
      <div class="result-panel">
        <p class="result-label">Prediction</p>
        <p class="placeholder" id="placeholder-msg">Draw a stroke, then classify it.</p>
        <div class="verdict" id="verdict" role="status" hidden>
          <p class="verdict-hand" id="verdict-hand"></p>
          <p class="verdict-confidence"><span id="confidence-value"></span>% confidence</p>
          <div class="confidence-bar">
            <div class="confidence-fill" id="confidence-fill"></div>
          </div>
          <p class="confidence-caption" id="confidence-caption"></p>
        </div>
        <button type="button" id="classify-btn" disabled>Classify stroke</button>
      </div>

      <div class="break-it">
        <p class="break-it-label">Try to break it</p>
        <p>Draw another stroke and change only one thing:</p>
        <ul>
          <li>make it longer</li>
          <li>make it more curved</li>
          <li>simplify the shape</li>
        </ul>
        <p>Can you make the prediction flip?</p>
      </div>
    </div>
  </div>

  <details class="reveal">
    <summary>What did the classifier actually key on?</summary>
    <p>
      This toy model was "trained" on a few dozen quick sketches, not real
      brushwork, and it shows: of the features it scores, <strong>raw stroke
      length dominates the verdict</strong>, with curvature and speed
      variation trailing far behind. A single long, fast, perfectly ordinary
      scribble reads as a confident "Tang Yin hand." A short, careful,
      deliberate curve — closer to what an actual brush stroke looks like —
      often reads as "workshop copy," with just as much confidence.
    </p>
    <p>
      That's the failure Wren's lecture names directly: the model states its
      answer with total confidence regardless of whether the question was
      fair, and it only ever tells you what it was trained to recognise. Here,
      it was trained to recognise "long line," not "Tang Yin's hand" — and
      nothing about its output warns you which one you're getting.
    </p>
  </details>

  <h2>Where this classifier came from</h2>
  <p>
    <a href={withBase("/sessions/09-model-audit/")}>Seminar 9</a> and
    <a href={withBase("/lectures/week-09/")}>its lecture</a> both talk about Wren's
    stroke-level classifier — trained to separate hands from low-level
    features like curvature and pressure variation, and confidently wrong the
    moment you feed it something its training set never saw. This page can't
    ship that real model, so it ships a much smaller one built the same way:
    a few dozen strokes, a handful of features, no idea what it actually
    learned until you go looking.
  </p>
</ContentLayout>

<style>
  /* Three-step guide: compact, numbered, not a tutorial page. */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-block: 1.5rem 2rem;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding-inline-start: 0.85rem;
    border-inline-start: 3px solid var(--seal-red, var(--at-accent));
  }

  .step-num {
    display: block;
    font-family: var(--at-font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--seal-red, var(--at-accent));
  }

  .step-title {
    display: block;
    font-family: Georgia, "Noto Serif", "Songti SC", serif;
    font-size: 1.1rem;
    margin-block: 0.15rem 0.2rem;
  }

  .steps p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--at-text-secondary);
  }

  @media (max-width: 40rem) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* Classifier board: two columns on desktop (draw / result), one on mobile. */
  .audit-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-block: 1.5rem 2rem;
    padding: 1.5rem;
    border: 1px solid var(--at-divider);
    border-inline-start: 3px solid var(--seal-red, var(--at-accent));
    border-radius: 0.5rem;
    background: var(--at-bg-elevated);
  }

  @media (max-width: 48rem) {
    .audit-board {
      grid-template-columns: 1fr;
    }
  }

  .audit-draw,
  .audit-result {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #stroke-canvas {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    aspect-ratio: 520 / 260;
    touch-action: none;
    border-radius: 0.4rem;
    background: #fdfbf5;
    border: 1px solid var(--at-divider);
    cursor: crosshair;
  }

  .hint {
    margin: 0;
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  button {
    align-self: flex-start;
    font: inherit;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--at-divider);
    background: var(--at-bg);
    color: var(--at-text);
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #classify-btn:not(:disabled) {
    border-color: var(--seal-red, var(--at-accent));
    background: var(--seal-red, var(--at-accent));
    color: var(--at-on-primary, #fff);
  }

  .result-panel {
    padding: 1rem 1.25rem;
    border: 1px solid var(--at-divider);
    border-radius: 0.4rem;
    background: var(--at-bg);
  }

  .result-label {
    margin: 0 0 0.5rem;
    font-family: var(--at-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-muted);
  }

  .placeholder {
    color: var(--at-text-muted);
    font-size: 0.95rem;
  }

  .verdict {
    margin-block-end: 1rem;
  }

  .verdict-hand {
    font-family: Georgia, "Noto Serif", "Songti SC", serif;
    font-size: 1.5rem;
    margin: 0 0 0.15rem;
  }

  .verdict-confidence {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--seal-red, var(--at-accent));
    margin: 0 0 0.6rem;
  }

  .confidence-bar {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--at-bg-alt);
    border: 1px solid var(--at-divider);
    overflow: hidden;
  }

  .confidence-fill {
    height: 100%;
    width: 0%;
    background: var(--seal-red, var(--at-accent));
  }

  .confidence-caption {
    margin-block-start: 0.5rem;
    font-size: 0.9rem;
    color: var(--at-text-secondary);
  }

  .break-it {
    padding: 1rem 1.25rem;
    border: 1px dashed var(--at-divider);
    border-radius: 0.4rem;
  }

  .break-it-label {
    margin: 0 0 0.4rem;
    font-family: var(--at-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--seal-red, var(--at-accent));
  }

  .break-it p,
  .break-it ul {
    margin: 0.3rem 0;
    font-size: 0.92rem;
    color: var(--at-text-secondary);
  }

  .break-it ul {
    padding-inline-start: 1.2rem;
  }

  .reveal {
    margin-block: 2rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--at-divider);
    border-radius: 0.5rem;
  }

  .reveal summary {
    cursor: pointer;
    font-weight: 600;
  }
</style>

<script>
  interface Point {
    x: number;
    y: number;
    t: number;
  }

  const canvas = document.getElementById("stroke-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const classifyBtn = document.getElementById("classify-btn") as HTMLButtonElement;
  const clearBtn = document.getElementById("clear-btn") as HTMLButtonElement;
  const placeholder = document.getElementById("placeholder-msg") as HTMLElement;
  const verdict = document.getElementById("verdict") as HTMLElement;
  const verdictHand = document.getElementById("verdict-hand") as HTMLElement;
  const confidenceValue = document.getElementById("confidence-value") as HTMLElement;
  const confidenceFill = document.getElementById("confidence-fill") as HTMLElement;
  const confidenceCaption = document.getElementById("confidence-caption") as HTMLElement;

  // Confidence is always reported for the winning side, so the same three
  // bands apply regardless of which hand the model landed on.
  function interpretConfidence(confidence: number): string {
    if (confidence < 60) return "The model is almost uncertain — 50% would mean an even split.";
    if (confidence <= 75) return "The model has a moderate preference.";
    return "The model strongly prefers this classification.";
  }

  let points: Point[] = [];
  let drawing = false;

  function toLocal(event: PointerEvent): Point {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    return {
      x: (event.clientX - rect.left) * scaleX,
      y: (event.clientY - rect.top) * scaleY,
      t: event.timeStamp,
    };
  }

  function redraw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (points.length < 2) return;
    ctx.strokeStyle = "#2a2620";
    ctx.lineWidth = 3;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.beginPath();
    ctx.moveTo(points[0].x, points[0].y);
    for (const point of points.slice(1)) ctx.lineTo(point.x, point.y);
    ctx.stroke();
  }

  canvas.addEventListener("pointerdown", (event) => {
    drawing = true;
    points = [toLocal(event)];
    verdict.hidden = true;
    placeholder.hidden = false;
    classifyBtn.disabled = true;
    canvas.setPointerCapture(event.pointerId);
  });

  canvas.addEventListener("pointermove", (event) => {
    if (!drawing) return;
    points.push(toLocal(event));
    redraw();
  });

  function stopDrawing() {
    if (!drawing) return;
    drawing = false;
    classifyBtn.disabled = points.length < 4;
  }

  canvas.addEventListener("pointerup", stopDrawing);
  canvas.addEventListener("pointerleave", stopDrawing);

  clearBtn.addEventListener("click", () => {
    points = [];
    redraw();
    verdict.hidden = true;
    placeholder.hidden = false;
    classifyBtn.disabled = true;
  });

  // A deliberately shallow "classifier": it presents itself as reading
  // curvature and speed variation, but length dominates the actual score.
  // That mismatch is the point, not a bug.
  function classify() {
    let length = 0;
    let turning = 0;
    const speeds: number[] = [];
    for (let i = 1; i < points.length; i++) {
      const prev = points[i - 1];
      const cur = points[i];
      const dx = cur.x - prev.x;
      const dy = cur.y - prev.y;
      const segment = Math.hypot(dx, dy);
      length += segment;
      const dt = Math.max(cur.t - prev.t, 1);
      speeds.push(segment / dt);
      if (i >= 2) {
        const prev2 = points[i - 2];
        const angle1 = Math.atan2(prev.y - prev2.y, prev.x - prev2.x);
        const angle2 = Math.atan2(dy, dx);
        let delta = Math.abs(angle2 - angle1);
        if (delta > Math.PI) delta = 2 * Math.PI - delta;
        turning += delta;
      }
    }

    const avgSpeed = speeds.reduce((a, b) => a + b, 0) / (speeds.length || 1);
    const speedVariance =
      speeds.reduce((sum, s) => sum + (s - avgSpeed) ** 2, 0) / (speeds.length || 1);
    const curvature = turning / Math.max(length, 1);

    // Normalised, hand-tuned so a short careful curve and a long fast
    // scribble land on opposite sides — length is weighted an order of
    // magnitude above the "real" features it's supposedly reading.
    const lengthScore = Math.min(length / 900, 1);
    const curvatureScore = Math.min(curvature * 40, 1);
    const speedVarianceScore = Math.min(speedVariance * 2, 1);

    const raw =
      lengthScore * 0.75 + (1 - curvatureScore) * 0.15 + speedVarianceScore * 0.1;
    const confidence = Math.round(Math.min(Math.max(raw, 0.02), 0.98) * 100);
    const isTangYin = raw >= 0.5;
    const winningConfidence = isTangYin ? confidence : 100 - confidence;

    verdictHand.textContent = isTangYin ? "Tang Yin's hand" : "Workshop copy";
    confidenceValue.textContent = String(winningConfidence);
    confidenceFill.style.width = `${winningConfidence}%`;
    confidenceCaption.textContent = interpretConfidence(winningConfidence);
    placeholder.hidden = true;
    verdict.hidden = false;
  }

  classifyBtn.addEventListener("click", classify);
</script>
