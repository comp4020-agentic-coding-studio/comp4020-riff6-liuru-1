---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { siteConfig } from "../site-config";
---

<ContentLayout
  title="Break the stroke classifier"
  description="Week 9 describes running a stroke-level classifier live and trying
    to break it. This is a toy version of that same exercise, playable right
    here."
  {...siteConfig}
>
  <p>
    <a href={withBase("/sessions/09-model-audit/")}>Seminar 9</a> and
    <a href={withBase("/lectures/week-09/")}>its lecture</a> both talk about Wren's
    stroke-level classifier — trained to separate hands from low-level
    features like curvature and pressure variation, and confidently wrong the
    moment you feed it something its training set never saw. This page can't
    ship that real model, so it ships a much smaller one built the same way:
    a few dozen strokes, a handful of features, no idea what it actually
    learned until you go looking.
  </p>

  <div class="audit-board" id="audit-board">
    <canvas
      id="stroke-canvas"
      width="520"
      height="260"
      aria-label="Drawing canvas: draw one stroke with your mouse or finger"
    ></canvas>
    <p class="hint">Draw one stroke. Then see what the classifier thinks.</p>
    <div class="controls">
      <button type="button" id="classify-btn" disabled>Classify this stroke</button>
      <button type="button" id="clear-btn">Clear</button>
    </div>

    <div class="verdict" id="verdict" role="status" hidden>
      <p class="verdict-label"><span id="verdict-hand"></span></p>
      <div class="confidence-bar">
        <div class="confidence-fill" id="confidence-fill"></div>
      </div>
      <p class="confidence-caption" id="confidence-caption"></p>
    </div>
  </div>

  <details class="reveal">
    <summary>What did the classifier actually key on?</summary>
    <p>
      This toy model was "trained" on a few dozen quick sketches, not real
      brushwork, and it shows: of the features it scores, <strong>raw stroke
      length dominates the verdict</strong>, with curvature and speed
      variation trailing far behind. A single long, fast, perfectly ordinary
      scribble reads as a confident "Tang Yin hand." A short, careful,
      deliberate curve — closer to what an actual brush stroke looks like —
      often reads as "workshop copy," with just as much confidence.
    </p>
    <p>
      That's the failure Wren's lecture names directly: the model states its
      answer with total confidence regardless of whether the question was
      fair, and it only ever tells you what it was trained to recognise. Here,
      it was trained to recognise "long line," not "Tang Yin's hand" — and
      nothing about its output warns you which one you're getting.
    </p>
  </details>
</ContentLayout>

<style>
  .audit-board {
    margin-block: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--at-border, #ccc);
    border-radius: 0.75rem;
    background: var(--at-bg-alt);
  }

  #stroke-canvas {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    aspect-ratio: 520 / 260;
    touch-action: none;
    border-radius: 0.5rem;
    background: #fdfbf5;
    border: 1px solid var(--at-border, #ccc);
    cursor: crosshair;
  }

  .hint {
    margin-block: 0.5rem 0.75rem;
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  .controls {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .controls button {
    font: inherit;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--at-border, #ccc);
    background: var(--at-bg, #fff);
    cursor: pointer;
  }

  .controls button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .controls button#classify-btn:not(:disabled) {
    background: var(--at-text-secondary);
    color: var(--at-bg, #fff);
  }

  .verdict {
    margin-block-start: 1.25rem;
  }

  .verdict-label {
    font-size: 1.2rem;
    font-weight: 600;
    margin-block-end: 0.4rem;
  }

  .confidence-bar {
    height: 0.6rem;
    border-radius: 999px;
    background: var(--at-bg, #fff);
    border: 1px solid var(--at-border, #ccc);
    overflow: hidden;
  }

  .confidence-fill {
    height: 100%;
    width: 0%;
    background: var(--at-text-secondary);
  }

  .confidence-caption {
    margin-block-start: 0.4rem;
    font-size: 0.9rem;
    color: var(--at-text-secondary);
  }

  .reveal {
    margin-block: 2rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--at-border, #ccc);
    border-radius: 0.75rem;
  }

  .reveal summary {
    cursor: pointer;
    font-weight: 600;
  }
</style>

<script>
  interface Point {
    x: number;
    y: number;
    t: number;
  }

  const canvas = document.getElementById("stroke-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const classifyBtn = document.getElementById("classify-btn") as HTMLButtonElement;
  const clearBtn = document.getElementById("clear-btn") as HTMLButtonElement;
  const verdict = document.getElementById("verdict") as HTMLElement;
  const verdictHand = document.getElementById("verdict-hand") as HTMLElement;
  const confidenceFill = document.getElementById("confidence-fill") as HTMLElement;
  const confidenceCaption = document.getElementById("confidence-caption") as HTMLElement;

  let points: Point[] = [];
  let drawing = false;

  function toLocal(event: PointerEvent): Point {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    return {
      x: (event.clientX - rect.left) * scaleX,
      y: (event.clientY - rect.top) * scaleY,
      t: event.timeStamp,
    };
  }

  function redraw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (points.length < 2) return;
    ctx.strokeStyle = "#2a2620";
    ctx.lineWidth = 3;
    ctx.lineJoin = "round";
    ctx.lineCap = "round";
    ctx.beginPath();
    ctx.moveTo(points[0].x, points[0].y);
    for (const point of points.slice(1)) ctx.lineTo(point.x, point.y);
    ctx.stroke();
  }

  canvas.addEventListener("pointerdown", (event) => {
    drawing = true;
    points = [toLocal(event)];
    verdict.hidden = true;
    classifyBtn.disabled = true;
    canvas.setPointerCapture(event.pointerId);
  });

  canvas.addEventListener("pointermove", (event) => {
    if (!drawing) return;
    points.push(toLocal(event));
    redraw();
  });

  function stopDrawing() {
    if (!drawing) return;
    drawing = false;
    classifyBtn.disabled = points.length < 4;
  }

  canvas.addEventListener("pointerup", stopDrawing);
  canvas.addEventListener("pointerleave", stopDrawing);

  clearBtn.addEventListener("click", () => {
    points = [];
    redraw();
    verdict.hidden = true;
    classifyBtn.disabled = true;
  });

  // A deliberately shallow "classifier": it presents itself as reading
  // curvature and speed variation, but length dominates the actual score.
  // That mismatch is the point, not a bug.
  function classify() {
    let length = 0;
    let turning = 0;
    const speeds: number[] = [];
    for (let i = 1; i < points.length; i++) {
      const prev = points[i - 1];
      const cur = points[i];
      const dx = cur.x - prev.x;
      const dy = cur.y - prev.y;
      const segment = Math.hypot(dx, dy);
      length += segment;
      const dt = Math.max(cur.t - prev.t, 1);
      speeds.push(segment / dt);
      if (i >= 2) {
        const prev2 = points[i - 2];
        const angle1 = Math.atan2(prev.y - prev2.y, prev.x - prev2.x);
        const angle2 = Math.atan2(dy, dx);
        let delta = Math.abs(angle2 - angle1);
        if (delta > Math.PI) delta = 2 * Math.PI - delta;
        turning += delta;
      }
    }

    const avgSpeed = speeds.reduce((a, b) => a + b, 0) / (speeds.length || 1);
    const speedVariance =
      speeds.reduce((sum, s) => sum + (s - avgSpeed) ** 2, 0) / (speeds.length || 1);
    const curvature = turning / Math.max(length, 1);

    // Normalised, hand-tuned so a short careful curve and a long fast
    // scribble land on opposite sides — length is weighted an order of
    // magnitude above the "real" features it's supposedly reading.
    const lengthScore = Math.min(length / 900, 1);
    const curvatureScore = Math.min(curvature * 40, 1);
    const speedVarianceScore = Math.min(speedVariance * 2, 1);

    const raw =
      lengthScore * 0.75 + (1 - curvatureScore) * 0.15 + speedVarianceScore * 0.1;
    const confidence = Math.round(Math.min(Math.max(raw, 0.02), 0.98) * 100);
    const isTangYin = raw >= 0.5;

    verdictHand.textContent = isTangYin
      ? `Tang Yin's hand — ${confidence}% confident`
      : `Workshop copy — ${100 - confidence}% confident`;
    confidenceFill.style.width = `${isTangYin ? confidence : 100 - confidence}%`;
    confidenceCaption.textContent = isTangYin
      ? "High confidence. No hedge, no second opinion offered."
      : "High confidence in the other direction. Same model, same certainty.";
    verdict.hidden = false;
  }

  classifyBtn.addEventListener("click", classify);
</script>
